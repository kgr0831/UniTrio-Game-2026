MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 27b51db780604ee43a0022a3bbe7c290, type: 3}
  m_Name: TUT_001_Intro
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSO
  Participants:
  - {fileID: 11400000, guid: 28c7e8e4715b0cd41ac71e810635a911, type: 2}
  - {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
  Lines:
  - Speaker: {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
    Text: "\uC77C\uC5B4\uB098\uC168\uAD70\uC694 \uBAA8\uD5D8\uAC00\uB2D8. \uC800\uB294
      \uB9C8\uBC95\uC0AC\uC778 \uC5D0\uB4DC\uB9B0\uC785\uB2C8\uB2E4."
  - Speaker: {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
    Text: "\uBAA8\uD5D8\uAC00\uB2D8\uC740 \uC774 \uC232\uC5D0 \uC4F0\uB7EC\uC838
      \uACC4\uC168\uC2B5\uB2C8\uB2E4."
  - Speaker: {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
    Text: "\uC774 \uC232\uC740 \uC704\uD5D8\uD569\uB2C8\uB2E4. \uBB34\uAE30\uB294
      \uC788\uC73C\uC2E0\uAC00\uC694?"
  - Speaker: {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
    Text: "\uC774 \uC232\uC758 \uC7AC\uB8CC\uB97C \uC774\uC6A9\uD574\uC11C \uBB34\uAE30\uB97C
      \uB9CC\uB4DC\uC2E4 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uC81C\uAC00 \uBC29\uBC95\uC744
      \uC54C\uB824\uB4DC\uB9AC\uC8E0."
  - Speaker: {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
    Text: "\uC800\uAE30 \uC800 \uB098\uBB34\uB97C \uAE30\uBCF8 \uACF5\uACA9\uC73C\uB85C
      \uCCD0\uBCF4\uC138\uC694. \uB098\uBB34 \uC870\uAC01\uC744 \uC5BB\uC744 \uC218
      \uC788\uC5B4\uC694!"
  - Speaker: {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
    Text: "\uADF8\uB9AC\uACE0 \uC800\uCABD \uB3CC\uB3C4 \uACF5\uACA9\uD574\uC11C
      \uCC44\uC9D1\uD574 \uC8FC\uC138\uC694."
  - Speaker: {fileID: 11400000, guid: 4af88c83cfb0dc6479186baa0ac816e2, type: 2}
    Text: "\uC7AC\uB8CC\uAC00 \uBAA8\uC774\uBA74 I\uD0A4\uB85C \uC778\uBCA4\uD1A0\uB9AC\uB97C
      \uC5F4\uC5B4 \uB3CC \uAC80\uC744 \uB9CC\uB4E4\uC5B4\uBD10\uC694!"
  OnDialogueStart:
    m_PersistentCalls:
      m_Calls: []
  OnDialogueEnd:
    m_PersistentCalls:
      m_Calls: []
